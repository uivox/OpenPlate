{
  "expo": {
    "name": "Tellerwerk",
    "slug": "openplate",
    "scheme": "openplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.uivox.tellerwerk",
      "infoPlist": {
        "NSCameraUsageDescription": "Tellerwerk uses the camera to scan barcodes and photograph meals.",
        "NSPhotoLibraryUsageDescription": "Tellerwerk lets you pick meal photos for AI recognition.",
        "NSMotionUsageDescription": "Tellerwerk reads your step count to show daily activity.",
        "NSLocalNetworkUsageDescription": "Tellerwerk can talk to an AI model running on your own computer.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "io.github.uivox.tellerwerk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#9C2F62"
      },
      "permissions": ["android.permission.health.READ_STEPS"],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Tellerwerk uses the camera to scan barcodes and photograph meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tellerwerk lets you pick meal photos for AI recognition."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Tellerwerk reads your step count to show daily activity."
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tellerwerk uses Face ID only to unlock the app when you turn on the app lock."
        }
      ],
      "react-native-health-connect",
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidStorageSize",
      "./plugins/withAlternateIconAliases",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "BeetWink",
            "ios": "./assets/app-icons/beet-wink.png",
            "android": {
              "foregroundImage": "./assets/app-icons/beet-wink-foreground.png",
              "backgroundColor": "#9C2F62"
            }
          },
          {
            "name": "BeetBright",
            "ios": "./assets/app-icons/beet-bright.png",
            "android": {
              "foregroundImage": "./assets/app-icons/beet-bright-foreground.png",
              "backgroundColor": "#9C2F62"
            }
          },
          {
            "name": "BeetHeart",
            "ios": "./assets/app-icons/beet-heart.png",
            "android": {
              "foregroundImage": "./assets/app-icons/beet-heart-foreground.png",
              "backgroundColor": "#9C2F62"
            }
          },
          {
            "name": "Ocean",
            "ios": "./assets/app-icons/ocean-happy.png",
            "android": {
              "foregroundImage": "./assets/app-icons/ocean-happy-foreground.png",
              "backgroundColor": "#0E7C86"
            }
          },
          {

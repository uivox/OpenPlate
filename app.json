{
  "expo": {
    "name": "OpenPlate",
    "slug": "openplate",
    "scheme": "openplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.uivox.openplate",
      "infoPlist": {
        "NSCameraUsageDescription": "OpenPlate uses the camera to scan barcodes and photograph meals.",
        "NSPhotoLibraryUsageDescription": "OpenPlate lets you pick meal photos for AI recognition.",
        "NSMotionUsageDescription": "OpenPlate reads your step count to show daily activity.",
        "NSLocalNetworkUsageDescription": "OpenPlate can talk to an AI model running on your own computer.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "io.github.uivox.openplate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF2E5"
      },
      "permissions": ["android.permission.health.READ_STEPS"],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenPlate uses the camera to scan barcodes and photograph meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenPlate lets you pick meal photos for AI recognition."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "OpenPlate reads your step count to show daily activity."
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OpenPlate uses Face ID only to unlock the app when you turn on the app lock."
        }
      ],
      "react-native-health-connect",
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidStorageSize",
      "./plugins/withAlternateIconAliases",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Ocean",
            "ios": "./assets/app-icons/ocean.png",
            "android": {
              "foregroundImage": "./assets/app-icons/ocean-foreground.png",
              "backgroundColor": "#E8F2F4"
            }
          },
          {
            "name": "Plum",
            "ios": "./assets/app-icons/plum.png",
            "android": {
              "foregroundImage": "./assets/app-icons/plum-foreground.png",
              "backgroundColor": "#F4EEF7"
            }
          },
          {
            "name": "Sunset",
            "ios": "./assets/app-icons/sunset.png",
            "android": {
              "foregroundImage": "./assets/app-icons/sunset-foreground.png",
              "backgroundColor": "#FAF0E6"
            }
          },
          {
            "name": "Mono",
            "ios": "./assets/app-icons/mono.png",
            "android": {
              "foregroundImage": "./assets/app-icons/mono-foreground.png",
              "backgroundColor": "#F1F1EF"
            }
          },
          {
            "name": "Night",
            "ios": "./assets/app-icons/night.png",
            "android": {
              "foregroundImage": "./assets/app-icons/night-foreground.png",
              "backgroundColor": "#1B1220"
            }
          }
        ]
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#EEF2E5",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2E5"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/favicon-32.png",
      "name": "OpenPlate",
      "shortName": "OpenPlate",
      "themeColor": "#EEF2E5",
      "backgroundColor": "#EEF2E5"
    }
  }
}

              "backgroundColor": "#0E7C86"
            }
          },
          {
            "name": "Plum",
            "ios": "./assets/app-icons/plum-happy.png",
            "android": {
              "foregroundImage": "./assets/app-icons/plum-happy-foreground.png",
              "backgroundColor": "#7B3FC4"
            }
          },
          {

              "backgroundColor": "#1B1220"
            }
          }
        ]
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#EEF2E5",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2E5"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/favicon-32.png",
      "name": "Tellerwerk",
      "shortName": "Tellerwerk",
      "themeColor": "#EEF2E5",
      "backgroundColor": "#EEF2E5"
    }
  }
}

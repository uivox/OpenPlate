{
  "name": "openplate",
  "version": "1.0.0",
  "private": true,
  "description": "Free, open-source calorie tracker for iPhone and the web with AI photo logging, barcode scanner, fasting timer, water, weight and steps.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "check": "tsc --noEmit",
    "fix-deps": "expo install --fix",
    "test": "tsc -p tests/tsconfig.json && node --test .test-build/tests/logic.test.js",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/web-pwa.mjs dist"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.0",
    "@expo-google-fonts/figtree": "^0.4.0",
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-health-connect": "~4.1.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
